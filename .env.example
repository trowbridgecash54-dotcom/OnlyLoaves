# OnlyLoafs environment variables
# ---------------------------------------------------------------------
# Locally: copy this file to ".env.local" and fill it in.
# On Vercel: Project → Settings → Environment Variables, same names.
# Never commit real secret values to GitHub.

# --- Supabase (database, owner sign-in, photo storage) — REQUIRED ------
# Supabase dashboard → your project → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://otmyxbkncfgmuwpqhcan.supabase.co
# Publishable key (starts sb_publishable_). Safe to expose; row-level
# security decides what it can read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ymRYP7JkNgDnF8qqeyfBHA_J_tU_0uI
# Secret key (starts sb_secret_). SERVER ONLY. Used to save the three
# public forms. Without it, requests can only be emailed, not stored.
SUPABASE_SECRET_KEY=

# --- The site's public address — set once a domain is connected ------
# Until then, Vercel's own address is used automatically.
NEXT_PUBLIC_SITE_URL=

# --- Email notifications (Resend) — OPTIONAL -------------------------
# Requests are always saved in the dashboard. These only add an email
# copy to the owner. Leave blank to turn email off.
RESEND_API_KEY=
# The inbox that receives notifications. Never shown on the site.
ORDERS_TO_EMAIL=
# Leave blank to use Resend's test sender, which only delivers to the
# address the Resend account was created with. After verifying your own
# domain in Resend, use e.g.  OnlyLoafs <orders@yourdomain.com>
ORDERS_FROM_EMAIL=
